{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve garden (Quartz)",
      "type": "shell",
      "command": "task",
      "args": ["serve"],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*?$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*bootstrap-cli.*",
          "endsPattern": "^.*listening on.*"
        }
      }
    }
  ]
}
