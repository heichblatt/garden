{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Group all non-major npm updates into one weekly PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "npm dependencies (non-major)",
      "automerge": true
    },
    {
      "description": "Keep major npm updates as separate PRs",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "description": "Group all GitHub Actions updates into one weekly PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "GitHub Actions (non-major)",
      "automerge": true
    },
    {
      "description": "Keep major GitHub Actions updates as separate PRs",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    }
  ]
}
